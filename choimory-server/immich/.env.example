# 환경변수 전체 목록: https://docs.immich.app/install/environment-variables

# 업로드된 사진·동영상 저장 위치 (나중에 대용량 디스크를 /data/nas에 마운트해도 경로는 그대로)
UPLOAD_LOCATION=/data/nas/photos

# DB 데이터 저장 위치. 네트워크 공유 경로는 지원하지 않는다.
DB_DATA_LOCATION=/data/apps/immich/postgres

TZ=Asia/Seoul

# 사용할 Immich 버전. 업그레이드 전 릴리스 노트의 Breaking Changes를 확인한다.
IMMICH_VERSION=v3.3.5

# Postgres 비밀번호. 랜덤 값으로 변경한다. (A-Za-z0-9만 사용, 특수문자·공백 금지)
DB_PASSWORD=changeme

# 아래 값은 변경할 필요 없음
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
