# tailscale serve 주소 (포트 포함)
DOMAIN=https://choimory-server.<tailnet>.ts.net:8443

# 본인 계정 생성 후 false로 변경
SIGNUPS_ALLOWED=true

# /admin 페이지 토큰의 argon2 해시. 아래 명령으로 생성한다.
#   docker run --rm -it vaultwarden/server:1.37.4 /vaultwarden hash
# 해시에 포함된 $가 compose 변수로 해석되지 않도록 반드시 작은따옴표로 감싼다.
ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$change-me'
