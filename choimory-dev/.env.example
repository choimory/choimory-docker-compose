# cp .env.example .env 후 사용한다. .env는 커밋하지 않는다.
# $는 compose 변수로 해석되므로 값에 쓰지 않는다.

# profile 미지정 시 적용할 기본 profile (명령의 --profile이 우선한다)
# 모든 서비스에 profile이 있으므로 지우면 profile 없는 up/down이 아무 서비스도 대상으로 삼지 않는다.
COMPOSE_PROFILES=all

# PostgreSQL 계정과 member-api용 database. 최초 기동(데이터 디렉토리가 비어 있을 때)에만 적용된다.
POSTGRES_USER=choimory
# 사용 시 변경
POSTGRES_PASSWORD=changeme
POSTGRES_DB=choimory_dev_member

# Redis ACL 계정
REDIS_USER=choimory
# 사용 시 변경
REDIS_PASSWORD=changeme

# member-api JWT 서명 키 (HS256, 32바이트 이상). 예: openssl rand -base64 48
# 사용 시 변경
JWT_SECRET=changeme

# 앱 레포 위치 (build.context). 상대경로는 compose.yaml 위치 기준이며 절대경로도 된다.
# compose에 기본값이 없는 필수 값이라, 지우면 모든 compose 명령이 멈춘다.
MEMBER_API_CONTEXT=../../../choimory-dev/choimory-dev-member-api
FRONT_CONTEXT=../../../choimory-dev/choimory-dev-front
